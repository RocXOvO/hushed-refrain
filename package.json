{
  "name": "ncm-comment-finder",
  "version": "0.30.4",
  "private": true,
  "main": "dist/electron-main.js",
  "description": "Checkpointed NetEase Cloud Music and QQ Music comment finder",
  "author": "Music Comment Trace Contributors",
  "license": "MIT",
  "bin": {
    "ncm-comments": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "tsx src/cli.ts",
    "web": "tsx src/cli.ts web",
    "desktop": "npm run build && electron .",
    "desktop:smoke": "npm run build && set NCM_DESKTOP_SMOKE=1&& electron .",
    "desktop:smoke:mac": "npm run build && NCM_DESKTOP_SMOKE=1 electron .",
    "bench:qq": "tsx scripts/benchmark-qq-music.ts",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && node scripts/build-mac.cjs arm64",
    "dist:mac:all": "npm run build && node scripts/build-mac.cjs arm64 x64"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.39.0",
    "electron-updater": "6.8.9",
    "lucide-static": "1.28.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "cn.local.ncm.commentfinder",
    "productName": "乐评寻踪",
    "afterPack": "build/after-pack.cjs",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RocXOvO",
        "repo": "ncm-comment-finder",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "web/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "electronUpdaterCompatibility": ">=2.16",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NCM-Comment-Finder-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false,
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "NCM-Comment-Finder-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "乐评寻踪 ${version}",
      "iconSize": 112,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "乐评寻踪"
    }
  }
}
